#!/usr/bin/env python3
"""
pizm-checkpoint: Minimal freeze primitive for Prism same-host staged reasoning.

Stdlib-only CLI that materializes blind seam checkpoints without provider calls,
session mapping, or selection logic. Enforces immutability and hash verification.
"""
import argparse
import hashlib
import json
import os
import re
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

# Stage -> contract revealed AFTER verified freeze of that stage (reveal semantics).
# A None value marks a terminal stage: nothing further to reveal.
# Schema documentation association:
#   development-v2 is defined by references/deep.md
#   deep-review-v2 is defined by references/deep-reviewer.md
#   (hidden until verified freeze, same pattern as the existing deep stage)
_CONTRACT_MAP = {
    "explore": "references/explore-selector.md",
    "deep": "references/deep-reviewer.md",
    "lever-design": "references/lever-reviewer.md",
    "lever-review": None,
    "search-field": "references/explore.md",
    "portfolio": "references/explore-selector.md",
    "development-v2": None,
    "deep-review-v2": None,
    "comparison-review-v1": None,
    "comparison": None,
}

_SCHEMA_VERSIONS = {
    "explore": "pizm-candidates-v1",
    "deep": "pizm-development-v1",
    "lever-design": "pizm-lever-design-v1",
    "lever-review": "pizm-lever-review-v1",
    "search-field": "pizm-search-field-v1",
    "portfolio": "pizm-portfolio-selection-v1",
    "development-v2": "pizm-development-v2",
    "deep-review-v2": "pizm-deep-review-v2",
    "comparison-review-v1": "pizm-comparison-review-v1",
    "comparison": "pizm-comparison-review-v1",
}


# Payload safety bounds (R1, R2)
_EXPLORE_MAX_CANDIDATES = 20
_EXPLORE_MAX_TOTAL_BYTES = 196608  # 192 KiB
_EXPLORE_MAX_SINGLE_CANDIDATE_BYTES = 12288  # 12 KiB
_LEVER_MAX_TOTAL_BYTES = 65536  # 64 KiB
_SEARCH_FIELD_MAX_TOTAL_BYTES = 32768  # 32 KiB
_PORTFOLIO_MAX_TOTAL_BYTES = 163840  # 160 KiB
_DEVELOPMENT_V2_MAX_TOTAL_BYTES = 196608  # 192 KiB
_DEEP_REVIEW_V2_MAX_TOTAL_BYTES = 131072  # 128 KiB
_COMPARISON_REVIEW_MAX_TOTAL_BYTES = 131072  # 128 KiB

# Deep v2 load-bearing claim census: authoritative epistemic status enum
_EPISTEMIC_STATUSES = ("SUPPORTED", "INFERRED", "SPECULATIVE", "UNKNOWN")

# Critic v2 terminal states — identical set to the v1 deep review (no fourth status)
_DEEP_REVIEW_TERMINAL_STATES = ("MODEL_READY", "NEED_EVIDENCE", "RETURN_TO_EXPLORE")
_COMPARISON_PREFERENCE_STATES = ("LEFT", "RIGHT", "CONDITIONAL", "UNRESOLVED")
_COMPETITION_STATUSES = ("TWO_DEFENSIBLE_BUNDLES", "NO_SECOND_DEFENSIBLE_BUNDLE")
_DEEP_IDENTITY_FIELDS = (
    "title",
    "core_claim",
    "structural_shift",
    "mechanism",
    "boundary",
)

_LEVER_REQUIRED_FIELDS = (
    "lever_id",
    "intervention_or_test_point",
    "model_link",
    "minimum_bounded_move",
    "expected_observation_or_response",
    "disconfirming_signal",
    "stop_condition",
    "remaining_assumptions",
)

_RUN_ID_RE = re.compile(r"[a-z0-9-]+\Z")
_P_ID_RE = re.compile(r"P[1-9][0-9]*\Z")
_B_ID_RE = re.compile(r"B[1-9][0-9]*\Z")
_PASS_ID_RE = re.compile(r"pass[0-9]{2,}\Z")
_COMPOSITE_REF_RE = re.compile(r"pass[0-9]{2,}:[A-Za-z0-9_-]+\Z")

def _die(msg: str, code: int = 1) -> int:
    print(f"ERROR: {msg}", file=sys.stderr)
    return code


def _cleanup_stage(run_dir: Path, prefix: str) -> None:
    """Remove all stage-scoped outputs on any post-write failure."""
    for suffix in (".json", ".sha256", ".meta.json"):
        p = run_dir / (prefix + suffix)
        try:
            p.unlink()
        except FileNotFoundError:
            pass

def _validate_run_id(run_id: str) -> None:
    if not isinstance(run_id, str) or not _RUN_ID_RE.fullmatch(run_id):
        raise ValueError("run-id must be lowercase alphanumeric with hyphens")


def _validate_explore(data: dict, raw_bytes_len: int = 0) -> None:
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != _SCHEMA_VERSIONS["explore"]:
        raise ValueError(f"schema_version must be {_SCHEMA_VERSIONS['explore']!r}")
    if data.get("stage") != "explore":
        raise ValueError("stage field must be 'explore'")
    if data.get("mode") not in ("NORMAL", "360", "RIFT"):
        raise ValueError("mode must be NORMAL|360|RIFT")
    candidates = data.get("candidates")
    if not isinstance(candidates, list) or len(candidates) == 0:
        raise ValueError("candidates must be a non-empty list")

    # Payload safety bounds enforcement (R1)
    if raw_bytes_len > _EXPLORE_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: total candidates artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_EXPLORE_MAX_TOTAL_BYTES} bytes (192 KiB)"
        )
    if len(candidates) > _EXPLORE_MAX_CANDIDATES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: candidate count {len(candidates)} "
            f"exceeds maximum {_EXPLORE_MAX_CANDIDATES}"
        )

    seen = set()
    for i, c in enumerate(candidates):
        if not isinstance(c, dict):
            raise ValueError(f"candidates[{i}] must be an object")
        cid = c.get("candidate_id")
        if not isinstance(cid, str) or not cid:
            raise ValueError(f"candidates[{i}].candidate_id must be non-empty string")
        if cid in seen:
            raise ValueError(f"duplicate candidate_id: {cid!r}")
        seen.add(cid)
        cand_bytes = json.dumps(c).encode("utf-8")
        if len(cand_bytes) > _EXPLORE_MAX_SINGLE_CANDIDATE_BYTES:
            raise ValueError(
                f"PAYLOAD_TOO_LARGE: candidate[{i}] ({cid}) serialized size "
                f"{len(cand_bytes)} bytes exceeds maximum {_EXPLORE_MAX_SINGLE_CANDIDATE_BYTES} bytes (12 KiB)"
            )

def _validate_deep(data: dict) -> None:
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != _SCHEMA_VERSIONS["deep"]:
        raise ValueError(f"schema_version must be {_SCHEMA_VERSIONS['deep']!r}")
    if data.get("stage") != "deep":
        raise ValueError("stage field must be 'deep'")
    p_ids = data.get("selected_p_ids")
    if not isinstance(p_ids, list) or len(p_ids) == 0:
        raise ValueError("selected_p_ids must be a non-empty list")
    seen = set()
    for pid in p_ids:
        if not isinstance(pid, str) or not (_P_ID_RE.fullmatch(pid) or pid == "DIRECT_SEED"):
            raise ValueError(f"selected_p_ids entries must match P[1-9][0-9]* or be 'DIRECT_SEED', got {pid!r}")
        if pid in seen:
            raise ValueError(f"duplicate selected_p_id: {pid!r}")
        seen.add(pid)
    dev = data.get("development")
    if not isinstance(dev, dict) or len(dev) == 0:
        raise ValueError("development must be a non-empty object")


def _validate_development_v2(data: dict, raw_bytes_len: int = 0) -> None:
    """Deep v2 artifact: exactly one target (P<n>, B<n>, or DIRECT_SEED), one developed model."""
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != _SCHEMA_VERSIONS["development-v2"]:
        raise ValueError(f"schema_version must be {_SCHEMA_VERSIONS['development-v2']!r}")
    if data.get("stage") != "development-v2":
        raise ValueError("stage field must be 'development-v2'")

    if raw_bytes_len > _DEVELOPMENT_V2_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: development-v2 artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_DEVELOPMENT_V2_MAX_TOTAL_BYTES} bytes (192 KiB)"
        )

    target = data.get("target")
    if not isinstance(target, dict):
        raise ValueError("target must be an object")
    target_type = target.get("target_type")
    if target_type not in ("P", "B"):
        raise ValueError(f"target.target_type must be P or B, got {target_type!r}")
    target_id = target.get("target_id")
    if not isinstance(target_id, str) or not target_id.strip():
        raise ValueError("target.target_id must be non-empty string")
    if target_type == "P":
        if not (_P_ID_RE.fullmatch(target_id) or target_id == "DIRECT_SEED"):
            raise ValueError(
                f"target.target_id {target_id!r} must match P[1-9][0-9]* or be "
                "'DIRECT_SEED' for target_type P"
            )
    elif not _B_ID_RE.fullmatch(target_id):
        raise ValueError(
            f"target.target_id {target_id!r} must match B[1-9][0-9]* for target_type B"
        )

    lock = data.get("identity_lock")
    if not isinstance(lock, dict) or len(lock) == 0:
        raise ValueError("identity_lock must be a non-empty object")
    member_refs = None
    if target_type == "P":
        if lock.get("p_id") != target_id:
            raise ValueError(
                f"identity_lock.p_id {lock.get('p_id')!r} must equal "
                f"target.target_id {target_id!r} (identity drift fails closed)"
            )
    else:
        # B identity lock preserves the bundle: bundle_id + member_refs frozen
        if lock.get("bundle_id") != target_id:
            raise ValueError(
                f"identity_lock.bundle_id {lock.get('bundle_id')!r} must equal "
                f"target.target_id {target_id!r} (identity drift fails closed)"
            )
        member_refs = lock.get("member_refs")
        if not isinstance(member_refs, list) or len(member_refs) < 2:
            raise ValueError(
                "identity_lock.member_refs must be a list of at least 2 composite refs "
                "(bundle membership is frozen into the identity lock)"
            )
        seen_members = set()
        for j, m in enumerate(member_refs):
            if not isinstance(m, str) or not _COMPOSITE_REF_RE.fullmatch(m):
                raise ValueError(
                    f"identity_lock.member_refs[{j}] must be a composite ref "
                    f"passNN:cNN, got {m!r}"
                )
            if m in seen_members:
                raise ValueError(f"identity_lock duplicate member_ref: {m!r}")
            seen_members.add(m)
    for field in _DEEP_IDENTITY_FIELDS:
        val = lock.get(field)
        if not isinstance(val, str) or not val.strip():
            raise ValueError(f"identity_lock.{field} must be non-empty string")

    model = data.get("developed_model")
    if not isinstance(model, dict) or len(model) == 0:
        raise ValueError("developed_model must be a non-empty object")

    thesis = model.get("thesis")
    if not isinstance(thesis, str) or not thesis.strip():
        raise ValueError("developed_model.thesis must be non-empty string")

    synthesis = model.get("synthesis")
    if not isinstance(synthesis, str) or not synthesis.strip():
        raise ValueError(
            "developed_model.synthesis must be first-class readable analytical prose "
            "(a single string), not a card list"
        )

    dynamics = model.get("dynamics")
    if not isinstance(dynamics, str) or not dynamics.strip():
        raise ValueError("developed_model.dynamics must be non-empty string")

    chain = model.get("mechanism_chain")
    if chain is not None:
        if not isinstance(chain, list) or not (3 <= len(chain) <= 6):
            raise ValueError(
                "developed_model.mechanism_chain must be a list of 3..6 causal steps"
            )
        for i, step in enumerate(chain):
            if not isinstance(step, str) or not step.strip():
                raise ValueError(
                    f"developed_model.mechanism_chain[{i}] must be non-empty string"
                )

    for field in ("implications", "predictions_or_observables", "break_conditions"):
        items = model.get(field)
        if not isinstance(items, list) or len(items) == 0:
            raise ValueError(f"developed_model.{field} must be a non-empty list")
        for i, item in enumerate(items):
            if not isinstance(item, str) or not item.strip():
                raise ValueError(f"developed_model.{field}[{i}] must be non-empty string")

    tensions = model.get("unresolved_tensions")
    if not isinstance(tensions, list):
        raise ValueError("developed_model.unresolved_tensions must be a list")
    if target_type == "B" and len(tensions) == 0:
        raise ValueError(
            "developed_model.unresolved_tensions must be non-empty for a Bundle target "
            "(the composition's internal tension is mandatory)"
        )
    for i, t in enumerate(tensions):
        if not isinstance(t, str) or not t.strip():
            raise ValueError(
                f"developed_model.unresolved_tensions[{i}] must be non-empty string"
            )

    debt = model.get("evidence_debt")
    if not isinstance(debt, list):
        raise ValueError("developed_model.evidence_debt must be a list")
    for i, d in enumerate(debt):
        if not isinstance(d, str) or not d.strip():
            raise ValueError(f"developed_model.evidence_debt[{i}] must be non-empty string")

    census = model.get("load_bearing_claims")
    if not isinstance(census, list) or not (2 <= len(census) <= 5):
        raise ValueError(
            "developed_model.load_bearing_claims must be a census of 2..5 claims"
        )
    for i, claim in enumerate(census):
        if not isinstance(claim, dict):
            raise ValueError(f"developed_model.load_bearing_claims[{i}] must be an object")
        for field in ("claim", "role_in_model", "what_would_weaken_or_refute"):
            val = claim.get(field)
            if not isinstance(val, str) or not val.strip():
                raise ValueError(
                    f"developed_model.load_bearing_claims[{i}].{field} must be "
                    "non-empty string"
                )
        status = claim.get("epistemic_status")
        if status not in _EPISTEMIC_STATUSES:
            raise ValueError(
                f"developed_model.load_bearing_claims[{i}].epistemic_status must be one "
                f"of SUPPORTED|INFERRED|SPECULATIVE|UNKNOWN, got {status!r}"
            )

    contributions = model.get("member_contributions")
    ablation = model.get("member_ablation")
    if target_type == "B":
        expected_members = set(member_refs)
        if (
            not isinstance(contributions, dict)
            or set(contributions.keys()) != expected_members
        ):
            raise ValueError(
                "developed_model.member_contributions must have exactly one entry per "
                "identity_lock.member_ref for a Bundle target"
            )
        for k, v in contributions.items():
            if not isinstance(v, str) or not v.strip():
                raise ValueError(
                    f"developed_model.member_contributions[{k!r}] must be non-empty string"
                )
        if not isinstance(ablation, dict) or set(ablation.keys()) != expected_members:
            raise ValueError(
                "developed_model.member_ablation must have exactly one entry per "
                "identity_lock.member_ref for a Bundle target "
                "(what disappears when that member is removed)"
            )
        for k, v in ablation.items():
            if not isinstance(v, str) or not v.strip():
                raise ValueError(
                    f"developed_model.member_ablation[{k!r}] must be non-empty string"
                )
    else:
        if contributions is not None:
            raise ValueError(
                "developed_model.member_contributions applies only to Bundle targets (B)"
            )
        if ablation is not None:
            raise ValueError(
                "developed_model.member_ablation applies only to Bundle targets (B)"
            )


def _validate_deep_review_v2(
    data: dict,
    raw_bytes_len: int = 0,
    project_root: Path | None = None,
    run_dir: Path | None = None,
) -> None:
    """Independent critic record over a frozen development-v2 artifact."""
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != _SCHEMA_VERSIONS["deep-review-v2"]:
        raise ValueError(f"schema_version must be {_SCHEMA_VERSIONS['deep-review-v2']!r}")
    if data.get("stage") != "deep-review-v2":
        raise ValueError("stage field must be 'deep-review-v2'")

    if raw_bytes_len > _DEEP_REVIEW_V2_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: deep-review-v2 artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_DEEP_REVIEW_V2_MAX_TOTAL_BYTES} bytes (128 KiB)"
        )

    frozen_hash = data.get("frozen_hash")
    if not isinstance(frozen_hash, str) or not frozen_hash.strip():
        raise ValueError("frozen_hash must be non-empty string")

    target_type = data.get("target_type")
    if target_type not in ("P", "B"):
        raise ValueError(f"target_type must be P or B, got {target_type!r}")
    target_id = data.get("target_id")
    if not isinstance(target_id, str) or not target_id.strip():
        raise ValueError("target_id must be non-empty string")
    if target_type == "P":
        if not (_P_ID_RE.fullmatch(target_id) or target_id == "DIRECT_SEED"):
            raise ValueError(
                f"target_id {target_id!r} must match P[1-9][0-9]* or be 'DIRECT_SEED' "
                "for target_type P"
            )
    elif not _B_ID_RE.fullmatch(target_id):
        raise ValueError(
            f"target_id {target_id!r} must match B[1-9][0-9]* for target_type B"
        )

    if project_root is not None:
        target_ref = data.get("target_ref") or data.get("development_ref")
        if not target_ref:
            if target_type == "B" and run_dir is not None and (run_dir / f"development-v2-{target_id}.json").exists():
                target_ref = f"development-v2-{target_id}.json"
            else:
                target_ref = "development-v2.json"
        target_path = _resolve_pizm_artifact(target_ref, project_root, run_dir)
        _verify_artifact_and_sidecar(
            target_path,
            expected_hash=frozen_hash,
            field_name="target_ref" if (data.get("target_ref") or data.get("development_ref")) else "frozen_hash",
        )
    target_type = data.get("target_type")
    if target_type not in ("P", "B"):
        raise ValueError(f"target_type must be P or B, got {target_type!r}")
    target_id = data.get("target_id")
    if not isinstance(target_id, str) or not target_id.strip():
        raise ValueError("target_id must be non-empty string")
    if target_type == "P":
        if not (_P_ID_RE.fullmatch(target_id) or target_id == "DIRECT_SEED"):
            raise ValueError(
                f"target_id {target_id!r} must match P[1-9][0-9]* or be 'DIRECT_SEED' "
                "for target_type P"
            )
    elif not _B_ID_RE.fullmatch(target_id):
        raise ValueError(
            f"target_id {target_id!r} must match B[1-9][0-9]* for target_type B"
        )

    terminal_state = data.get("terminal_state")
    if terminal_state not in _DEEP_REVIEW_TERMINAL_STATES:
        raise ValueError(
            "terminal_state must be one of MODEL_READY|NEED_EVIDENCE|RETURN_TO_EXPLORE, "
            f"got {terminal_state!r}"
        )

    identity_verified = data.get("identity_verified")
    if not isinstance(identity_verified, bool):
        raise ValueError("identity_verified must be a boolean")

    countermodel = data.get("independent_countermodel")
    if not isinstance(countermodel, str) or not countermodel.strip():
        raise ValueError(
            "independent_countermodel must be non-empty string "
            "(the critic constructs its own countermodel)"
        )

    cheapest_test = data.get("cheapest_discriminating_test")
    if not isinstance(cheapest_test, str) or not cheapest_test.strip():
        raise ValueError("cheapest_discriminating_test must be non-empty string")

    reassessment = data.get("load_bearing_reassessment")
    if not isinstance(reassessment, list) or len(reassessment) == 0:
        raise ValueError(
            "load_bearing_reassessment must be a non-empty list "
            "(the critic independently reassesses each load-bearing claim; "
            "developer labels are not authority)"
        )
    for i, r in enumerate(reassessment):
        if not isinstance(r, dict):
            raise ValueError(f"load_bearing_reassessment[{i}] must be an object")
        claim = r.get("claim")
        if not isinstance(claim, str) or not claim.strip():
            raise ValueError(
                f"load_bearing_reassessment[{i}].claim must be non-empty string"
            )
        status = r.get("critic_epistemic_status")
        if status not in _EPISTEMIC_STATUSES:
            raise ValueError(
                f"load_bearing_reassessment[{i}].critic_epistemic_status must be one of "
                f"SUPPORTED|INFERRED|SPECULATIVE|UNKNOWN, got {status!r}"
            )

    findings = data.get("findings")
    if not isinstance(findings, dict):
        raise ValueError("findings must be an object")
    for field in (
        "cross_field_contradictions",
        "unsupported_specificity",
        "epistemic_laundering",
    ):
        items = findings.get(field) or []
        if not isinstance(items, list):
            raise ValueError(f"findings.{field} must be a list")
        for i, item in enumerate(items):
            if not isinstance(item, str) or not item.strip():
                raise ValueError(f"findings.{field}[{i}] must be non-empty string")
    unresolved_contradiction = findings.get("unresolved_load_bearing_contradiction", False)
    if not isinstance(unresolved_contradiction, bool):
        raise ValueError(
            "findings.unresolved_load_bearing_contradiction must be a boolean"
        )
    for field in ("identity_drift", "cost_relocation"):
        val = findings.get(field)
        if val is not None and not isinstance(val, str):
            raise ValueError(f"findings.{field} must be a string or null")
    round_trip = findings.get("round_trip_skeleton")
    if not isinstance(round_trip, str) or not round_trip.strip():
        raise ValueError(
            "findings.round_trip_skeleton must be non-empty string "
            "(structural skeleton recovered from the prose)"
        )
    member_ablation_finding = findings.get("member_ablation")
    if member_ablation_finding is not None and not isinstance(member_ablation_finding, str):
        raise ValueError("findings.member_ablation must be a string or null")

    evidence_debt = data.get("evidence_debt")
    if not isinstance(evidence_debt, list):
        raise ValueError("evidence_debt must be a list")
    for i, d in enumerate(evidence_debt):
        if not isinstance(d, str) or not d.strip():
            raise ValueError(f"evidence_debt[{i}] must be non-empty string")

    rationale = data.get("verdict_rationale")
    if not isinstance(rationale, str) or not rationale.strip():
        raise ValueError("verdict_rationale must be non-empty string")

    # Deterministic decision-rule couplings
    if unresolved_contradiction and terminal_state == "MODEL_READY":
        raise ValueError(
            "MODEL_READY is forbidden while findings.unresolved_load_bearing_contradiction "
            "is true (an unresolved load-bearing contradiction blocks MODEL_READY)"
        )
    if not identity_verified and terminal_state != "RETURN_TO_EXPLORE":
        raise ValueError(
            "identity_verified false requires RETURN_TO_EXPLORE "
            "(identity or composition collapse)"
        )
    if findings.get("unsupported_specificity") and len(evidence_debt) == 0:
        raise ValueError(
            "unsupported specificity findings require recorded evidence_debt "
            "(never launder invented specificity past the review)"
        )
    if target_type == "B" and not (
        isinstance(member_ablation_finding, str) and member_ablation_finding.strip()
    ):
        raise ValueError(
            "findings.member_ablation must carry a non-empty assessment for a Bundle target"
        )


def _validate_comparison_review(
    data: dict,
    raw_bytes_len: int = 0,
    project_root: Path | None = None,
    run_dir: Path | None = None,
) -> None:
    """Validate pizm-comparison-review-v1 artifact."""
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != "pizm-comparison-review-v1":
        raise ValueError("schema_version must be 'pizm-comparison-review-v1'")
    if data.get("stage") not in ("comparison-review-v1", "comparison"):
        raise ValueError("stage field must be 'comparison-review-v1' or 'comparison'")

    if raw_bytes_len > _COMPARISON_REVIEW_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: comparison-review artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_COMPARISON_REVIEW_MAX_TOTAL_BYTES} bytes (128 KiB)"
        )

    # Validate top-level target IDs
    left_target_id = data.get("left_target_id")
    right_target_id = data.get("right_target_id")
    if not isinstance(left_target_id, str) or not _B_ID_RE.fullmatch(left_target_id):
        raise ValueError(f"left_target_id must match B[1-9][0-9]*, got {left_target_id!r}")
    if not isinstance(right_target_id, str) or not _B_ID_RE.fullmatch(right_target_id):
        raise ValueError(f"right_target_id must match B[1-9][0-9]*, got {right_target_id!r}")
    if left_target_id == right_target_id:
        raise ValueError(f"left_target_id and right_target_id must be distinct, got {left_target_id!r}")

    # Reject legacy keys
    if "review_B1" in data or "review_B2" in data:
        raise ValueError("legacy review_B1/review_B2 fields are forbidden; use left_review/right_review")

    # Validate left_review and right_review
    for role_key, expected_target in (("left_review", left_target_id), ("right_review", right_target_id)):
        review = data.get(role_key)
        if not isinstance(review, dict):
            raise ValueError(f"{role_key} must be an object")
        target_id = review.get("target_id")
        if target_id != expected_target:
            raise ValueError(f"{role_key}.target_id must be {expected_target!r}, got {target_id!r}")
        terminal_state = review.get("terminal_state")
        if terminal_state not in _DEEP_REVIEW_TERMINAL_STATES:
            raise ValueError(
                f"{role_key}.terminal_state must be one of {list(_DEEP_REVIEW_TERMINAL_STATES)}, got {terminal_state!r}"
            )
        findings = review.get("findings")
        if not isinstance(findings, dict):
            raise ValueError(f"{role_key}.findings must be an object")
        unresolved = findings.get("unresolved_load_bearing_contradiction", False)
        if not isinstance(unresolved, bool):
            raise ValueError(f"{role_key}.findings.unresolved_load_bearing_contradiction must be boolean")
        if unresolved and terminal_state == "MODEL_READY":
            raise ValueError(
                f"{role_key}: MODEL_READY is forbidden while unresolved_load_bearing_contradiction is true"
            )
        reassessment = review.get("load_bearing_reassessment")
        if not isinstance(reassessment, list) or len(reassessment) == 0:
            raise ValueError(f"{role_key}.load_bearing_reassessment must be a non-empty list")
        for idx, item in enumerate(reassessment):
            if not isinstance(item, dict):
                raise ValueError(f"{role_key}.load_bearing_reassessment[{idx}] must be an object")
            if not isinstance(item.get("claim"), str) or not item.get("claim").strip():
                raise ValueError(f"{role_key}.load_bearing_reassessment[{idx}].claim must be non-empty string")
            st = item.get("critic_epistemic_status")
            if st not in _EPISTEMIC_STATUSES:
                raise ValueError(
                    f"{role_key}.load_bearing_reassessment[{idx}].critic_epistemic_status must be one of {list(_EPISTEMIC_STATUSES)}"
                )
        countermodel = review.get("independent_countermodel")
        if not isinstance(countermodel, str) or not countermodel.strip():
            raise ValueError(f"{role_key}.independent_countermodel must be non-empty string")

        dev_ref = review.get("development_ref") or review.get("artifact_ref") or review.get("ref") or review.get("target_ref")
        dev_hash = review.get("frozen_hash") or review.get("development_hash") or review.get("hash")
        if not dev_ref:
            raise ValueError(f"{role_key} must declare development artifact reference (development_ref)")
        if not dev_hash:
            raise ValueError(f"{role_key} must declare development artifact hash (frozen_hash)")

        if project_root is not None:
            dev_path = _resolve_pizm_artifact(dev_ref, project_root, run_dir)
            raw_dev, _ = _verify_artifact_and_sidecar(
                dev_path,
                expected_hash=dev_hash,
                field_name=f"{role_key}.development_ref",
            )
            try:
                dev_data = json.loads(raw_dev)
            except json.JSONDecodeError:
                raise ValueError(f"{role_key} development artifact is not valid JSON")
            actual_target = (
                dev_data.get("target", {}).get("target_id")
                if isinstance(dev_data.get("target"), dict)
                else dev_data.get("target_id")
            )
            if actual_target != expected_target:
                raise ValueError(
                    f"{role_key}.development_ref target mismatch: expected {expected_target}, got {actual_target!r}"
                )

    # Portfolio verification
    if project_root is not None and run_dir is not None:
        portfolio_file = run_dir / "portfolio.json"
        if not portfolio_file.is_file():
            raise ValueError("comparison review requires a frozen portfolio.json")
        raw_port, _ = _verify_artifact_and_sidecar(portfolio_file, field_name="portfolio.json")
        try:
            port_data = json.loads(raw_port)
        except json.JSONDecodeError:
            raise ValueError("portfolio artifact is not valid JSON")
        if port_data.get("schema_version") != "pizm-portfolio-selection-v2":
            raise ValueError("comparison review requires pizm-portfolio-selection-v2 portfolio")
        if port_data.get("route") not in {"BONK", "FORGE"}:
            raise ValueError("comparison review requires portfolio route BONK")
        if port_data.get("competition_status") != "TWO_DEFENSIBLE_BUNDLES":
            raise ValueError("comparison review requires portfolio competition_status TWO_DEFENSIBLE_BUNDLES")
        rec_comp = port_data.get("recommended_competition") or {}
        p_left = rec_comp.get("left_bundle_id")
        p_right = rec_comp.get("right_bundle_id")
        if p_left != left_target_id or p_right != right_target_id:
            raise ValueError(
                f"comparison targets ({left_target_id}, {right_target_id}) do not match "
                f"portfolio recommended_competition ({p_left}, {p_right})"
            )
    # Validate comparison block
    comp = data.get("comparison")
    if not isinstance(comp, dict):
        raise ValueError("comparison must be an object")

    if "strongest_reason_for_B1" in comp or "strongest_reason_for_B2" in comp:
        raise ValueError("legacy strongest_reason_for_B1/B2 keys are forbidden; use strongest_reason_for_left/right")

    pref = comp.get("current_preference")
    if pref not in _COMPARISON_PREFERENCE_STATES:
        raise ValueError(
            f"comparison.current_preference must be one of {list(_COMPARISON_PREFERENCE_STATES)}, got {pref!r}"
        )

    for field in (
        "competition_axis",
        "strongest_reason_for_left",
        "strongest_reason_for_right",
        "discriminating_observation",
        "what_would_change_the_decision",
    ):
        v = comp.get(field)
        if not isinstance(v, str) or not v.strip():
            raise ValueError(f"comparison.{field} must be non-empty string")

    shared_debt = comp.get("shared_evidence_debt")
    if not isinstance(shared_debt, (list, str)):
        raise ValueError("comparison.shared_evidence_debt must be a list or string")

    # Decision-rule couplings
    review_left = data["left_review"]
    review_right = data["right_review"]

    if pref == "LEFT":
        if review_left.get("findings", {}).get("unresolved_load_bearing_contradiction"):
            raise ValueError(
                "preference LEFT is forbidden while left review has unresolved_load_bearing_contradiction"
            )
        if review_left.get("terminal_state") == "RETURN_TO_EXPLORE":
            raise ValueError(
                "preference LEFT is forbidden while left review terminal_state is RETURN_TO_EXPLORE"
            )
    elif pref == "RIGHT":
        if review_right.get("findings", {}).get("unresolved_load_bearing_contradiction"):
            raise ValueError(
                "preference RIGHT is forbidden while right review has unresolved_load_bearing_contradiction"
            )
        if review_right.get("terminal_state") == "RETURN_TO_EXPLORE":
            raise ValueError(
                "preference RIGHT is forbidden while right review terminal_state is RETURN_TO_EXPLORE"
            )
def _validate_lever_design(data: dict, raw_bytes_len: int = 0) -> None:
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != _SCHEMA_VERSIONS["lever-design"]:
        raise ValueError(f"schema_version must be {_SCHEMA_VERSIONS['lever-design']!r}")
    if data.get("stage") != "lever":
        raise ValueError("stage field must be 'lever'")

    if raw_bytes_len > _LEVER_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: lever design artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_LEVER_MAX_TOTAL_BYTES} bytes (64 KiB)"
        )

    levers = data.get("levers")
    if not isinstance(levers, list) or not (1 <= len(levers) <= 3):
        raise ValueError("levers must be a list of 1..3 items")

    seen = set()
    for i, l in enumerate(levers):
        if not isinstance(l, dict):
            raise ValueError(f"levers[{i}] must be an object")
        lid = l.get("lever_id")
        if not isinstance(lid, str) or not lid.strip():
            raise ValueError(f"levers[{i}].lever_id must be non-empty string")
        if lid in seen:
            raise ValueError(f"duplicate lever_id: {lid!r}")
        seen.add(lid)
        for field in _LEVER_REQUIRED_FIELDS:
            val = l.get(field)
            if not isinstance(val, str) or not val.strip():
                raise ValueError(f"levers[{i}].{field} must be non-empty string")
        if "adaptation_or_countermove" in l:
            ac = l.get("adaptation_or_countermove")
            if not isinstance(ac, str):
                raise ValueError(f"levers[{i}].adaptation_or_countermove must be a string")


def _validate_lever_review(data: dict, raw_bytes_len: int = 0) -> None:
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    if data.get("schema_version") != _SCHEMA_VERSIONS["lever-review"]:
        raise ValueError(f"schema_version must be {_SCHEMA_VERSIONS['lever-review']!r}")
    if data.get("stage") != "lever":
        raise ValueError("stage field must be 'lever'")

    if raw_bytes_len > _LEVER_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: lever review artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_LEVER_MAX_TOTAL_BYTES} bytes (64 KiB)"
        )

    frozen_hash = data.get("frozen_hash")
    if not isinstance(frozen_hash, str) or not frozen_hash.strip():
        raise ValueError("frozen_hash must be non-empty string")

    outcome = data.get("outcome")
    if outcome not in ("LEVER", "NO_DEFENSIBLE_LEVER"):
        raise ValueError(f"outcome must be LEVER or NO_DEFENSIBLE_LEVER, got {outcome!r}")

    verdicts = data.get("verdicts")
    if verdicts is not None:
        if not isinstance(verdicts, list):
            raise ValueError("verdicts must be a list")
        for i, v in enumerate(verdicts):
            if not isinstance(v, dict):
                raise ValueError(f"verdicts[{i}] must be an object")
            if "lever_id" in v and not isinstance(v["lever_id"], str):
                raise ValueError(f"verdicts[{i}].lever_id must be a string")
            if "verdict" in v and v["verdict"] not in ("ACCEPT", "REJECT"):
                raise ValueError(f"verdicts[{i}].verdict must be ACCEPT or REJECT, got {v['verdict']!r}")

def _assign_bundle_ids(previous_bundles, proposed_bundles):
    """Deterministic canonical B-ID assignment (pure function).

    previous_bundles: iterable of {"bundle_id": "B<n>", "member_refs": [...]}
        canonical bundles already assigned in earlier frozen portfolios.
    proposed_bundles: iterable of {"member_refs": [...]}.

    Returns a list of canonical bundle ids aligned with proposed_bundles order.

    Rules:
    - reuse preserves the prior id (membership matched order-insensitively);
    - fresh ids are allocated monotonically above every known id;
    - identical inputs always produce an identical assignment (no renumbering);
    - ambiguous prior state (two priors with identical membership) fails closed.
    """
    by_members = {}
    max_n = 0
    for b in previous_bundles:
        bid = b.get("bundle_id")
        if not isinstance(bid, str) or not _B_ID_RE.fullmatch(bid):
            raise ValueError(f"prior bundle_id must match B[1-9][0-9]*, got {bid!r}")
        members = b.get("member_refs")
        if not isinstance(members, list) or len(members) < 2:
            raise ValueError("prior bundle member_refs must be a list of at least 2 items")
        key = tuple(sorted(members))
        if key in by_members:
            raise ValueError(
                "ambiguous prior state: two prior bundles share identical membership"
            )
        by_members[key] = bid
        max_n = max(max_n, int(bid[1:]))

    assigned = []
    fresh_by_members = {}
    next_fresh = max_n + 1
    for prop in proposed_bundles:
        members = prop.get("member_refs")
        if not isinstance(members, list) or len(members) < 2:
            raise ValueError("proposed bundle member_refs must be a list of at least 2 items")
        key = tuple(sorted(members))
        if key in by_members:
            assigned.append(by_members[key])
        elif key in fresh_by_members:
            assigned.append(fresh_by_members[key])
        else:
            new_id = f"B{next_fresh}"
            next_fresh += 1
            fresh_by_members[key] = new_id
            assigned.append(new_id)
    return assigned


def _validate_search_field(
    data: dict,
    raw_bytes_len: int = 0,
    project_root: Path | None = None,
    run_dir: Path | None = None,
) -> None:
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    schema_version = data.get("schema_version")
    if schema_version != "pizm-search-field-v1":
        raise ValueError(f"schema_version must be 'pizm-search-field-v1', got {schema_version!r}")
    if data.get("stage") != "search-field":
        raise ValueError("stage field must be 'search-field'")

    if raw_bytes_len > _SEARCH_FIELD_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: search-field artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_SEARCH_FIELD_MAX_TOTAL_BYTES} bytes (32 KiB)"
        )

    passes = data.get("passes")
    if not isinstance(passes, list) or len(passes) == 0:
        raise ValueError("passes must be a non-empty list")

    known_passes = set()
    last_pass_num = -1
    for i, p in enumerate(passes):
        if not isinstance(p, dict):
            raise ValueError(f"passes[{i}] must be an object")
        pass_id = p.get("pass_id")
        if not isinstance(pass_id, str) or not _PASS_ID_RE.fullmatch(pass_id):
            raise ValueError(f"passes[{i}].pass_id must match passNN (e.g. pass01), got {pass_id!r}")
        if pass_id in known_passes:
            raise ValueError(f"duplicate pass_id: {pass_id!r}")
        known_passes.add(pass_id)
        pass_num = int(pass_id[4:])
        if pass_num <= last_pass_num:
            raise ValueError(f"passes must be strictly ascending: {pass_id} <= previous pass")
        last_pass_num = pass_num

        candidates_ref = p.get("candidates_ref")
        if not isinstance(candidates_ref, str) or not candidates_ref.strip():
            raise ValueError(f"passes[{i}].candidates_ref must be non-empty string")
        frozen_hash = p.get("frozen_hash")
        if not isinstance(frozen_hash, str) or not frozen_hash.strip():
            raise ValueError(f"passes[{i}].frozen_hash must be non-empty string")

        if project_root is not None:
            cand_path = _resolve_pizm_artifact(candidates_ref, project_root, run_dir)
            _verify_artifact_and_sidecar(
                cand_path,
                expected_hash=frozen_hash,
                field_name=f"passes[{i}].candidates_ref",
            )

    entries = data.get("entries")
    if not isinstance(entries, list) or len(entries) == 0:
        raise ValueError("entries must be a non-empty list")

    seen_refs = set()
    last_pass_n = 0
    for i, ref in enumerate(entries):
        if not isinstance(ref, str) or not _COMPOSITE_REF_RE.fullmatch(ref):
            raise ValueError(
                f"entries[{i}] must be a composite ref passNN:cNN, got {ref!r}"
            )
        if ref in seen_refs:
            raise ValueError(f"duplicate composite ref: {ref!r}")
        seen_refs.add(ref)
        pass_id = ref.split(":", 1)[0]
        if pass_id not in known_passes:
            raise ValueError(f"entries[{i}] references unregistered pass {pass_id!r}")
        pass_n = int(pass_id[4:])
        if pass_n < last_pass_n:
            raise ValueError(
                f"entries[{i}] violates append-only ordering "
                f"({pass_id} appears after its later pass)"
            )
        last_pass_n = pass_n

    prior_ref = data.get("prior_ref")
    prior_hash = data.get("prior_hash")
    if prior_ref is not None or prior_hash is not None:
        if not isinstance(prior_ref, str) or not prior_ref.strip():
            raise ValueError("prior_ref must be non-empty string when present")
        if not isinstance(prior_hash, str) or not prior_hash.strip():
            raise ValueError("prior_hash must be non-empty string when prior_ref is present")
        if project_root is not None:
            prior_path = _resolve_pizm_artifact(prior_ref, project_root, run_dir)
            raw_prior, _ = _verify_artifact_and_sidecar(
                prior_path,
                expected_hash=prior_hash,
                field_name="prior_ref",
            )
            try:
                prior_data = json.loads(raw_prior)
            except json.JSONDecodeError:
                raise ValueError("prior artifact is not valid JSON")

            prior_passes = prior_data.get("passes", [])
            if len(passes) != len(prior_passes) + 1:
                raise ValueError(
                    f"new snapshot must add exactly one pass (prior had {len(prior_passes)}, got {len(passes)})"
                )
            for j, pp in enumerate(prior_passes):
                if passes[j] != pp:
                    raise ValueError(f"pass {pp.get('pass_id')} mutated from prior snapshot")
            prior_entries = prior_data.get("entries", [])
            if len(entries) < len(prior_entries) or entries[:len(prior_entries)] != prior_entries:
                raise ValueError("new snapshot mutated, reordered, or removed prior entries")


def _validate_portfolio(
    data: dict,
    raw_bytes_len: int = 0,
    project_root: Path | None = None,
    run_dir: Path | None = None,
) -> None:
    if not isinstance(data, dict):
        raise ValueError("root must be a JSON object")
    schema_version = data.get("schema_version")
    if schema_version not in ("pizm-portfolio-selection-v1", "pizm-portfolio-selection-v2"):
        raise ValueError(
            f"schema_version must be 'pizm-portfolio-selection-v1' or 'pizm-portfolio-selection-v2', got {schema_version!r}"
        )
    if data.get("stage") != "portfolio":
        raise ValueError("stage field must be 'portfolio'")

    if raw_bytes_len > _PORTFOLIO_MAX_TOTAL_BYTES:
        raise ValueError(
            f"PAYLOAD_TOO_LARGE: portfolio artifact size {raw_bytes_len} bytes "
            f"exceeds maximum {_PORTFOLIO_MAX_TOTAL_BYTES} bytes (160 KiB)"
        )

    route = data.get("route")
    if schema_version == "pizm-portfolio-selection-v2":
        if route == "FORGE":
            route = "BONK"
            data["route"] = "BONK"
        if route != "BONK":
            raise ValueError(f"pizm-portfolio-selection-v2 requires route 'BONK', got {route!r}")
        if data.get("auto_target") is not None:
            raise ValueError("pizm-portfolio-selection-v2 forbids auto_target")
    else:
        if route not in ("MANUAL", "AUTO"):
            raise ValueError(f"route must be MANUAL or AUTO, got {route!r}")
        if data.get("single_target") is not None:
            raise ValueError("single_target is forbidden in pizm-portfolio-selection-v1")

    field_hash = data.get("field_hash")
    if not isinstance(field_hash, str) or not field_hash.strip():
        raise ValueError("field_hash must be non-empty string")

    # Resolve and verify search-field reference
    if schema_version == "pizm-portfolio-selection-v2":
        field_ref = data.get("field_ref")
        if not isinstance(field_ref, str) or not field_ref.strip():
            raise ValueError("pizm-portfolio-selection-v2 requires field_ref")
        if project_root is not None:
            field_path = _resolve_pizm_artifact(field_ref, project_root, run_dir)
            _verify_artifact_and_sidecar(
                field_path,
                expected_hash=field_hash,
                field_name="field_ref",
            )
    else:
        # v1 compatibility
        field_ref = data.get("field_ref")
        if field_ref and project_root is not None:
            field_path = _resolve_pizm_artifact(field_ref, project_root, run_dir)
            _verify_artifact_and_sidecar(
                field_path,
                expected_hash=field_hash,
                field_name="field_ref",
            )
        elif run_dir is not None:
            legacy_field = run_dir / "search-field.json"
            if legacy_field.is_file():
                _verify_artifact_and_sidecar(
                    legacy_field,
                    expected_hash=field_hash,
                    field_name="search-field.json",
                )

    assessments = data.get("candidate_assessments")
    if not isinstance(assessments, list) or len(assessments) == 0:
        raise ValueError("candidate_assessments must be a non-empty list")

    seen_refs = set()
    for i, a in enumerate(assessments):
        if not isinstance(a, dict):
            raise ValueError(f"candidate_assessments[{i}] must be an object")
        ref = a.get("candidate_ref")
        if not isinstance(ref, str) or not _COMPOSITE_REF_RE.fullmatch(ref):
            raise ValueError(
                f"candidate_assessments[{i}].candidate_ref must be a composite ref "
                f"passNN:cNN, got {ref!r}"
            )
        if ref in seen_refs:
            raise ValueError(f"duplicate candidate_ref: {ref!r}")
        seen_refs.add(ref)
        if a.get("disposition") not in ("KEEP", "BORDERLINE", "MERGE", "DROP"):
            raise ValueError(
                f"candidate_assessments[{i}].disposition must be KEEP|BORDERLINE|MERGE|DROP"
            )
        if a.get("standalone_quality") not in ("strong", "borderline", "weak"):
            raise ValueError(
                f"candidate_assessments[{i}].standalone_quality must be strong|borderline|weak"
            )
        if not isinstance(a.get("unique_residue"), str):
            raise ValueError(f"candidate_assessments[{i}].unique_residue must be a string")
        overlap = a.get("nearest_overlap")
        if overlap is not None and (
            not isinstance(overlap, str) or not _COMPOSITE_REF_RE.fullmatch(overlap)
        ):
            raise ValueError(
                f"candidate_assessments[{i}].nearest_overlap must be null or a "
                f"composite ref passNN:cNN, got {overlap!r}"
            )
        reason = a.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise ValueError(f"candidate_assessments[{i}].reason must be non-empty string")

    bundles = data.get("bundles")
    if not isinstance(bundles, list):
        raise ValueError("bundles must be a list")

    seen_bundle_ids = set()
    bundle_ids_in_artifact = []
    for i, b in enumerate(bundles):
        if not isinstance(b, dict):
            raise ValueError(f"bundles[{i}] must be an object")
        bid = b.get("bundle_id")
        if not isinstance(bid, str) or not _B_ID_RE.fullmatch(bid):
            raise ValueError(f"bundles[{i}].bundle_id must match B[1-9][0-9]*, got {bid!r}")
        if bid in seen_bundle_ids:
            raise ValueError(f"duplicate bundle_id: {bid!r}")
        seen_bundle_ids.add(bid)
        bundle_ids_in_artifact.append(bid)

        members = b.get("member_refs")
        if not isinstance(members, list) or len(members) < 2:
            raise ValueError(
                f"bundles[{i}].member_refs must be a list of at least 2 composite refs"
            )
        seen_members = set()
        for j, m in enumerate(members):
            if not isinstance(m, str) or not _COMPOSITE_REF_RE.fullmatch(m):
                raise ValueError(
                    f"bundles[{i}].member_refs[{j}] must be a composite ref passNN:cNN, got {m!r}"
                )
            if m in seen_members:
                raise ValueError(f"bundles[{i}] duplicate member_ref: {m!r}")
            seen_members.add(m)

        for field_name in ("bundle_thesis", "composition_gain", "new_consequence_or_prediction"):
            v = b.get(field_name)
            if not isinstance(v, str) or not v.strip():
                raise ValueError(f"bundles[{i}].{field_name} must be non-empty string")
        for field_name in ("internal_tension", "weakest_link"):
            if not isinstance(b.get(field_name), str):
                raise ValueError(f"bundles[{i}].{field_name} must be a string")

        roles = b.get("member_roles")
        if not isinstance(roles, dict):
            raise ValueError(f"bundles[{i}].member_roles must be an object")
        for k, v in roles.items():
            if k not in seen_members:
                raise ValueError(f"bundles[{i}].member_roles key {k!r} is not a member_ref")
            if not isinstance(v, str):
                raise ValueError(f"bundles[{i}].member_roles[{k!r}] must be a string")

        ablation = b.get("member_ablation")
        if not isinstance(ablation, dict) or set(ablation.keys()) != seen_members:
            raise ValueError(
                f"bundles[{i}].member_ablation must have exactly one non-empty entry per "
                "member_ref (member ablation is required; a removable passenger "
                "invalidates the bundle)"
            )
        for k, v in ablation.items():
            if not isinstance(v, str) or not v.strip():
                raise ValueError(f"bundles[{i}].member_ablation[{k!r}] must be non-empty string")

    auto_target = data.get("auto_target")
    if schema_version == "pizm-portfolio-selection-v1":
        if route == "AUTO":
            if not isinstance(auto_target, dict):
                raise ValueError("route AUTO requires exactly one auto_target object")
            ttype = auto_target.get("target_type")
            if ttype not in ("P", "B"):
                raise ValueError(f"auto_target.target_type must be P or B, got {ttype!r}")
            tid = auto_target.get("target_id")
            if not isinstance(tid, str) or not tid.strip():
                raise ValueError("auto_target.target_id must be non-empty string")
            if ttype == "P":
                if not _P_ID_RE.fullmatch(tid):
                    raise ValueError(
                        f"auto_target.target_id {tid!r} must match P[1-9][0-9]* for target_type P"
                    )
            elif tid not in seen_bundle_ids:
                raise ValueError(
                    f"auto_target.target_id {tid!r} must reference a bundle_id proposed in this portfolio"
                )
        elif auto_target is not None:
            raise ValueError("route MANUAL requires auto_target to be null")

    prior_bundles = data.get("prior_bundles")
    if prior_bundles is not None:
        if not isinstance(prior_bundles, list):
            raise ValueError("prior_bundles must be a list")
        expected = _assign_bundle_ids(prior_bundles, bundles)
        if bundle_ids_in_artifact != expected:
            raise ValueError(
                f"deterministic B-ID assignment violated: bundle ids {bundle_ids_in_artifact} "
                f"do not match canonical assignment {expected}; reuse preserves prior ids "
                "and user-visible ids are never renumbered"
            )

    # v2 validation
    if schema_version == "pizm-portfolio-selection-v2":
        perspectives = data.get("perspectives")
        if not isinstance(perspectives, dict) or len(perspectives) == 0:
            raise ValueError("v2 portfolio must have a non-empty perspectives mapping")

        seen_p_ids = set()
        seen_c_refs = set()
        last_p_num = 0
        for p_id, c_ref in perspectives.items():
            if not _P_ID_RE.fullmatch(p_id):
                raise ValueError(f"invalid perspective id format: {p_id!r}")
            p_n = int(p_id[1:])
            if p_n <= last_p_num:
                raise ValueError(f"P IDs must be strictly increasing: {p_id} <= previous")
            last_p_num = p_n
            if not _COMPOSITE_REF_RE.fullmatch(c_ref):
                raise ValueError(f"invalid candidate ref in perspectives: {c_ref!r}")
            if p_id in seen_p_ids:
                raise ValueError(f"duplicate perspective id: {p_id!r}")
            if c_ref in seen_c_refs:
                raise ValueError(f"duplicate candidate ref mapped: {c_ref!r}")
            if c_ref not in seen_refs:
                raise ValueError(f"perspective candidate_ref {c_ref!r} not found in assessments")
            seen_p_ids.add(p_id)
            seen_c_refs.add(c_ref)

        comp_status = data.get("competition_status")
        if comp_status not in _COMPETITION_STATUSES:
            raise ValueError(
                f"competition_status must be one of {list(_COMPETITION_STATUSES)}, got {comp_status!r}"
            )
        rec_comp = data.get("recommended_competition")
        single_target = data.get("single_target")
        if comp_status == "NO_SECOND_DEFENSIBLE_BUNDLE":
            if rec_comp is not None:
                raise ValueError(
                    "recommended_competition must be null when competition_status is NO_SECOND_DEFENSIBLE_BUNDLE"
                )
            if not isinstance(single_target, dict):
                raise ValueError(
                    "single_target is required when competition_status is NO_SECOND_DEFENSIBLE_BUNDLE"
                )
            st_type = single_target.get("target_type")
            if st_type not in ("B", "P"):
                raise ValueError(f"single_target.target_type must be B or P, got {st_type!r}")
            st_id = single_target.get("target_id")
            if not isinstance(st_id, str) or not st_id.strip():
                raise ValueError("single_target.target_id must be non-empty string")
            if st_type == "B":
                if not _B_ID_RE.fullmatch(st_id):
                    raise ValueError(f"single_target.target_id {st_id!r} must match B[1-9][0-9]* for target_type B")
                if st_id not in seen_bundle_ids:
                    raise ValueError(f"single_target.target_id {st_id!r} must reference a bundle_id proposed in this portfolio")
            elif st_type == "P":
                if not _P_ID_RE.fullmatch(st_id):
                    raise ValueError(f"single_target.target_id {st_id!r} must match P[1-9][0-9]* for target_type P")
                if st_id not in seen_p_ids:
                    raise ValueError(f"single_target.target_id {st_id!r} must reference a perspective id in perspectives mapping")
        elif comp_status == "TWO_DEFENSIBLE_BUNDLES":
            if single_target is not None:
                raise ValueError("single_target is forbidden when competition_status is TWO_DEFENSIBLE_BUNDLES")
            if not isinstance(rec_comp, dict):
                raise ValueError(
                    "recommended_competition must be an object when competition_status is TWO_DEFENSIBLE_BUNDLES"
                )
            if "bundle_a" in rec_comp or "bundle_b" in rec_comp:
                raise ValueError("recommended_competition must use left_bundle_id and right_bundle_id, not bundle_a/bundle_b")
            left_b = rec_comp.get("left_bundle_id")
            right_b = rec_comp.get("right_bundle_id")
            if not isinstance(left_b, str) or not _B_ID_RE.fullmatch(left_b):
                raise ValueError(f"recommended_competition.left_bundle_id must match B[1-9][0-9]*, got {left_b!r}")
            if not isinstance(right_b, str) or not _B_ID_RE.fullmatch(right_b):
                raise ValueError(f"recommended_competition.right_bundle_id must match B[1-9][0-9]*, got {right_b!r}")
            if left_b == right_b:
                raise ValueError(f"recommended_competition left_bundle_id and right_bundle_id must be distinct, got {left_b!r}")
            if left_b not in seen_bundle_ids or right_b not in seen_bundle_ids:
                raise ValueError(
                    "recommended_competition bundles must both be present in bundles list"
                )
            axis = rec_comp.get("competition_axis")
            if not isinstance(axis, str) or not axis.strip():
                raise ValueError("recommended_competition.competition_axis must be non-empty string")
            disc_obs = rec_comp.get("discriminating_observation")
            if not isinstance(disc_obs, str) or not disc_obs.strip():
                raise ValueError("recommended_competition.discriminating_observation must be non-empty string")
            if "discriminating_question" in rec_comp:
                dq = rec_comp.get("discriminating_question")
                if not isinstance(dq, str):
                    raise ValueError("recommended_competition.discriminating_question must be a string")

        prior_ref = data.get("prior_ref")
        prior_hash = data.get("prior_hash")
        if prior_ref is not None or prior_hash is not None:
            if not isinstance(prior_ref, str) or not prior_ref.strip():
                raise ValueError("prior_ref must be non-empty string when present")
            if not isinstance(prior_hash, str) or not prior_hash.strip():
                raise ValueError("prior_hash must be non-empty string when prior_ref is present")
            if project_root is not None:
                prior_path = _resolve_pizm_artifact(prior_ref, project_root, run_dir)
                raw_prior, _ = _verify_artifact_and_sidecar(
                    prior_path,
                    expected_hash=prior_hash,
                    field_name="prior_ref",
                )
                try:
                    prior_data = json.loads(raw_prior)
                except json.JSONDecodeError:
                    raise ValueError("prior artifact is not valid JSON")

                prior_perspectives = prior_data.get("perspectives", {})
                for old_p, old_c in prior_perspectives.items():
                    if perspectives.get(old_p) != old_c:
                        raise ValueError(f"mutated prior perspective mapping: {old_p}")

                prior_highest = max([int(pid[1:]) for pid in prior_perspectives] + [0])
                for p_id in perspectives:
                    if p_id not in prior_perspectives:
                        p_n = int(p_id[1:])
                        if p_n <= prior_highest:
                            raise ValueError(
                                f"newly assigned perspective {p_id} violates monotonic ID constraint (<= {prior_highest})"
                            )
def _sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _resolve_pizm_artifact(ref: str, project_root: Path, run_dir: Path | None = None) -> Path:
    """Resolve an artifact reference relative to <project-root>/.ai/pizm/ or run_dir for bare names.

    Rejects:
    - empty / whitespace-only / non-string
    - absolute paths
    - path traversal (..)
    - paths escaping <project-root>/.ai/pizm/ (using Path.is_relative_to)
    """
    if not isinstance(ref, str) or not ref.strip():
        raise ValueError(f"invalid artifact reference {ref!r}: must be non-empty string")
    p_ref = Path(ref.strip())
    if p_ref.is_absolute():
        raise ValueError(f"invalid artifact reference {ref!r}: absolute paths are forbidden")
    if ".." in p_ref.parts:
        raise ValueError(f"invalid artifact reference {ref!r}: path traversal is forbidden")

    pizm_root = (project_root / ".ai" / "pizm").resolve()

    if run_dir is not None and len(p_ref.parts) == 1:
        resolved = (run_dir / p_ref).resolve()
    else:
        resolved = (pizm_root / p_ref).resolve()

    try:
        if not resolved.is_relative_to(pizm_root) or resolved == pizm_root:
            raise ValueError(f"invalid artifact reference {ref!r}: path outside .ai/pizm root")
    except ValueError:
        raise ValueError(f"invalid artifact reference {ref!r}: path outside .ai/pizm root")

    return resolved


def _verify_artifact_and_sidecar(
    resolved_json: Path,
    expected_hash: str | None = None,
    field_name: str = "artifact",
) -> tuple[bytes, str]:
    """Verify resolved JSON artifact and its exact .sha256 sidecar bytes.

    Returns (raw_bytes, actual_hash).
    Diagnostics name field_name without leaking unrelated absolute paths.
    """
    if not resolved_json.is_file():
        raise ValueError(f"{field_name} references missing file: {resolved_json.name}")

    sha_path = resolved_json.with_suffix(".sha256")
    if not sha_path.is_file():
        raise ValueError(f"{field_name} references missing sidecar: {sha_path.name}")

    raw_bytes = resolved_json.read_bytes()
    actual_hash = _sha256_hex(raw_bytes)

    sidecar_text = sha_path.read_text(encoding="utf-8").strip()
    if sidecar_text != actual_hash:
        raise ValueError(f"{field_name} sidecar hash mismatch: expected {actual_hash}, got {sidecar_text}")

    if expected_hash is not None:
        if actual_hash != expected_hash:
            raise ValueError(f"{field_name} hash mismatch: expected {expected_hash}, got {actual_hash}")

    return raw_bytes, actual_hash

def _durable_exclusive_write(target: Path, data: bytes) -> None:
    """Write data to target with durable exclusive creation.

    Flow: mkstemp in target dir → fdopen write → flush → fsync →
    os.link(tmp, target) [fails if target exists] → unlink tmp →
    fsync parent dir.

    Raises OSError on any failure; cleans up temp file.
    """
    fd = None
    tmp_path = None
    try:
        fd, tmp_path = tempfile.mkstemp(dir=target.parent, prefix=".tmp-ckpt-")
        fh = os.fdopen(fd, "wb")
        fd = None  # fdopen owns the fd now
        try:
            written = 0
            while written < len(data):
                n = fh.write(data[written:])
                if n == 0:
                    raise OSError("short write: filesystem returned 0 bytes written")
                written += n
            fh.flush()
            os.fsync(fh.fileno())
        finally:
            fh.close()
        # Exclusive publish: link fails if target exists (concurrent-safe)
        os.link(tmp_path, target)
        os.unlink(tmp_path)
        tmp_path = None
        # Fsync parent directory for durability
        parent_fd = os.open(str(target.parent), os.O_RDONLY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    except BaseException:
        # Clean up temp file on any failure
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        raise


def _read_contract_file(skill_root: Path, rel_path: str) -> str:
    """Read hidden contract from relative path. Raises OSError on failure."""
    contract_path = skill_root / rel_path
    with open(contract_path, "r", encoding="utf-8") as f:
        return f.read()


def _read_contract(skill_root: Path, stage: str) -> str:
    """Read hidden contract. Raises OSError on failure. Never names path in error."""
    contract_rel = _CONTRACT_MAP[stage]
    return _read_contract_file(skill_root, contract_rel)


def _resolve_development_v2_next_contract(
    run_dir: Path,
    skill_root: Path,
    current_data: dict,
    current_target: str | None = None,
) -> str | None:
    """Context-aware contract resolver for development-v2 stage."""
    portfolio_file = run_dir / "portfolio.json"
    if not portfolio_file.is_file():
        # Standalone / no portfolio -> reveal deep-reviewer.md
        return _read_contract_file(skill_root, "references/deep-reviewer.md")

    # Portfolio present: verify sidecar
    try:
        raw_port, _ = _verify_artifact_and_sidecar(portfolio_file, field_name="portfolio.json")
        port_data = json.loads(raw_port)
    except Exception:
        # Corrupt sidecar / hash mismatch / invalid JSON -> fail closed (reveal nothing)
        return None

    schema = port_data.get("schema_version")
    route = port_data.get("route")
    if schema != "pizm-portfolio-selection-v2" or route not in {"BONK", "FORGE"}:
        # Non-v2 or not BONK/legacy FORGE (e.g. v1 MANUAL or AUTO) -> reveal deep-reviewer.md
        return _read_contract_file(skill_root, "references/deep-reviewer.md")

    comp_status = port_data.get("competition_status")
    if comp_status == "NO_SECOND_DEFENSIBLE_BUNDLE":
        single_target = port_data.get("single_target") or {}
        st_id = single_target.get("target_id")
        dev_target_id = current_target
        if not dev_target_id and isinstance(current_data, dict):
            dev_target_id = (
                current_data.get("target", {}).get("target_id")
                if isinstance(current_data.get("target"), dict)
                else current_data.get("target_id")
            )
        if st_id and dev_target_id == st_id:
            return _read_contract_file(skill_root, "references/deep-reviewer.md")
        return None

    elif comp_status == "TWO_DEFENSIBLE_BUNDLES":
        rec_comp = port_data.get("recommended_competition") or {}
        left_id = rec_comp.get("left_bundle_id")
        right_id = rec_comp.get("right_bundle_id")
        if not left_id or not right_id:
            return None

        # Resolve left file
        left_file = run_dir / f"development-v2-{left_id}.json"
        if not left_file.is_file():
            unsuffixed = run_dir / "development-v2.json"
            if unsuffixed.is_file():
                left_file = unsuffixed
            else:
                return None

        # Resolve right file
        right_file = run_dir / f"development-v2-{right_id}.json"
        if not right_file.is_file():
            return None

        # Verify both files and sidecars
        try:
            raw_left, _ = _verify_artifact_and_sidecar(left_file, field_name=left_file.name)
            left_json = json.loads(raw_left)
            actual_left_target = (
                left_json.get("target", {}).get("target_id")
                if isinstance(left_json.get("target"), dict)
                else left_json.get("target_id")
            )
            if actual_left_target != left_id:
                return None

            raw_right, _ = _verify_artifact_and_sidecar(right_file, field_name=right_file.name)
            right_json = json.loads(raw_right)
            actual_right_target = (
                right_json.get("target", {}).get("target_id")
                if isinstance(right_json.get("target"), dict)
                else right_json.get("target_id")
            )
            if actual_right_target != right_id:
                return None
        except Exception:
            return None

        # Both valid and hash-confirmed! Reveal deep-compare.md
        return _read_contract_file(skill_root, "references/deep-compare.md")

    return None


def freeze(
    stage: str, run_id: str, input_path: str,
    project_root: Path, skill_root: Path,
    target: str = None,
    artifact_suffix: str = None,
) -> int:
    # Validate run-id early
    try:
        _validate_run_id(run_id)
    except ValueError as e:
        return _die(str(e))

    # Read and parse input
    try:
        with open(input_path, "rb") as f:
            raw = f.read()
    except OSError:
        return _die("cannot read input file")

    try:
        data = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        return _die("input is not valid JSON")

    run_dir = project_root / ".ai" / "pizm" / f"run-{run_id}"
    # Validate schema
    try:
        if stage == "explore":
            _validate_explore(data, len(raw))
        elif stage == "deep":
            _validate_deep(data)
        elif stage == "development-v2":
            _validate_development_v2(data, len(raw))
        elif stage == "deep-review-v2":
            _validate_deep_review_v2(data, len(raw), project_root, run_dir)
        elif stage == "lever-design":
            _validate_lever_design(data, len(raw))
        elif stage == "lever-review":
            _validate_lever_review(data, len(raw))
        elif stage == "search-field":
            _validate_search_field(data, len(raw), project_root, run_dir)
        elif stage == "portfolio":
            _validate_portfolio(data, len(raw), project_root, run_dir)
        elif stage in ("comparison-review-v1", "comparison"):
            _validate_comparison_review(data, len(raw), project_root, run_dir)
        else:
            return _die(f"unknown stage: {stage!r}")
    except ValueError as e:
        msg = str(e)
        if msg.startswith("PAYLOAD_TOO_LARGE"):
            return _die(msg)
        return _die(f"schema validation failed: {e}")

    if target and stage in ("development-v2", "deep-review-v2"):
        payload_target = (
            data.get("target", {}).get("target_id")
            if isinstance(data.get("target"), dict)
            else data.get("target_id")
        )
        if payload_target != target:
            return _die(f"--target {target!r} does not match payload target_id {payload_target!r}")

    # Create run directory
    run_dir = project_root / ".ai" / "pizm" / f"run-{run_id}"
    run_dir.mkdir(parents=True, exist_ok=True)

    # Determine stage-scoped file names
    if stage == "explore":
        prefix = "candidates"
    elif stage == "deep":
        prefix = "development"
    elif stage == "development-v2":
        if target:
            prefix = f"development-v2-{target}"
        else:
            prefix = "development-v2"
    elif stage == "deep-review-v2":
        if target:
            prefix = f"deep-review-v2-{target}"
        else:
            prefix = "deep-review-v2"
    elif stage == "lever-design":
        prefix = "design"
    elif stage == "lever-review":
        prefix = "review"
    elif stage == "search-field":
        prefix = "search-field"
    elif stage == "portfolio":
        prefix = "portfolio"
    elif stage in ("comparison-review-v1", "comparison"):
        prefix = "comparison-review-v1"
    else:
        prefix = stage

    if artifact_suffix:
        if stage not in ("explore", "search-field"):
            return _die("artifact-suffix is only supported for explore and search-field stages")
        if not _PASS_ID_RE.fullmatch(artifact_suffix):
            return _die(f"invalid artifact-suffix format: {artifact_suffix}")
        prefix += f"-{artifact_suffix}"

    artifact_name = prefix + ".json"
    sha_name = prefix + ".sha256"
    meta_name = prefix + ".meta.json"

    # Create run directory
    run_dir = project_root / ".ai" / "pizm" / f"run-{run_id}"
    run_dir.mkdir(parents=True, exist_ok=True)

    artifact_path = run_dir / artifact_name
    sha_path = run_dir / sha_name
    meta_path = run_dir / meta_name

    # Compute hash
    computed_hash = _sha256_hex(raw)

    # Write artifact (exclusive, durable)
    try:
        _durable_exclusive_write(artifact_path, raw)
    except FileExistsError:
        return _die("frozen artifact already exists, refusing overwrite")
    except OSError as e:
        return _die(f"failed to write artifact: {e}")

    # Write sha256 sidecar (plain hex)
    try:
        _durable_exclusive_write(sha_path, computed_hash.encode("utf-8"))
    except FileExistsError:
        _cleanup_stage(run_dir, prefix)
        return _die("frozen sha256 already exists, refusing overwrite")
    except OSError as e:
        _cleanup_stage(run_dir, prefix)
        return _die(f"failed to write sha256: {e}")

    # Write stage-scoped metadata
    meta = {
        "sha256": computed_hash,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id,
        "stage": stage,
        "schema_version": data.get("schema_version", _SCHEMA_VERSIONS.get(stage, "")),
    }
    try:
        _durable_exclusive_write(
            meta_path, json.dumps(meta, indent=2).encode("utf-8")
        )
    except FileExistsError:
        _cleanup_stage(run_dir, prefix)
        return _die("frozen metadata already exists, refusing overwrite")
    except OSError as e:
        _cleanup_stage(run_dir, prefix)
        return _die(f"failed to write metadata: {e}")
    # Read back and verify hash
    try:
        readback = artifact_path.read_bytes()
    except OSError as e:
        _cleanup_stage(run_dir, prefix)
        return _die(f"failed to read back artifact: {e}")

    if _sha256_hex(readback) != computed_hash:
        _cleanup_stage(run_dir, prefix)
        return _die("hash mismatch after write")

    # Read contract AFTER hash-confirmed freeze.
    # Map value None = terminal stage: nothing further to reveal (deep-review-v2,
    # lever-review).
    contract_text = None
    if stage == "development-v2":
        try:
            contract_text = _resolve_development_v2_next_contract(
                run_dir=run_dir,
                skill_root=skill_root,
                current_data=data,
                current_target=target,
            )
        except OSError:
            _cleanup_stage(run_dir, prefix)
            return _die("cannot read next-stage contract")
    elif _CONTRACT_MAP.get(stage) is None:
        contract_text = None
    elif stage == "lever-design":
        # Reveal only reference path/name, never rubric body
        contract_rel = _CONTRACT_MAP.get(stage)
        contract_path = skill_root / contract_rel
        if not contract_path.is_file():
            _cleanup_stage(run_dir, prefix)
            return _die("cannot find next-stage contract")
        contract_text = contract_rel
    else:
        try:
            contract_text = _read_contract(skill_root, stage)
        except OSError:
            _cleanup_stage(run_dir, prefix)
            return _die("cannot read next-stage contract")

    # All verified — emit success output
    print(f"FREEZE_OK {computed_hash}")
    print(f"ARTIFACT {artifact_path}")
    print(f"SHA256 {sha_path}")
    print(f"META {meta_path}")
    if contract_text:
        print("\n--- NEXT CONTRACT ---")
        print(contract_text)
    return 0

def main() -> int:
    parser = argparse.ArgumentParser(
        description="Freeze checkpoint for Prism staged reasoning"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    fp = sub.add_parser("freeze", help="Freeze artifact checkpoint")
    fp.add_argument(
        "--stage",
        required=True,
        choices=[
            "explore", "deep", "development-v2", "deep-review-v2",
            "lever-design", "lever-review", "search-field", "portfolio",
            "comparison-review-v1", "comparison",
        ],
    )
    fp.add_argument("--target", default=None, help="Target ID (e.g. B1, B2) for target-scoped artifacts")
    fp.add_argument("--artifact-suffix", default=None, help="Optional suffix for Search artifacts (passNN)")
    fp.add_argument("--run-id", required=True)
    fp.add_argument("--input", required=True, dest="input_path")
    fp.add_argument("--project-root", default=".")
    fp.add_argument(
        "--skill-root",
        default=os.path.expanduser("~/.config/opencode/skills/pizm"),
    )

    args = parser.parse_args()

    if args.command == "freeze":
        return freeze(
            stage=args.stage,
            run_id=args.run_id,
            input_path=args.input_path,
            project_root=Path(args.project_root).resolve(),
            skill_root=Path(args.skill_root).resolve(),
            target=args.target,
            artifact_suffix=args.artifact_suffix,
        )


if __name__ == "__main__":
    sys.exit(main())
