#!/usr/bin/env python3
"""Thin CLI wrapper for tools.failure_log."""

import os
import sys

# Ensure the project root is on PYTHONPATH so the isolated package is importable
# regardless of how this wrapper is invoked.
_PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, _PROJECT_ROOT)

from tools.failure_log.cli import main

if __name__ == "__main__":
    sys.exit(main())
