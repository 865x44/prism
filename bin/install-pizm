#!/usr/bin/env python3
"""
install-pizm: Native Pizm Skill & Helper Installer.

Installs the native Pizm skill to target host harnesses (Claude Code, OpenCode, or both)
and sets up helper executables in $HOME/.local/bin.

Zero API keys. Zero provider configuration. Pure local installation.
"""
from __future__ import annotations

import argparse
import os
import shutil
import stat
import subprocess
import sys
from pathlib import Path

HELPERS = [
    "pizm-checkpoint",
    "pizm-session-bundle",
    "pizm-reader-server",
    "pizm_render_html.py",
]


def check_skill_roots_coherence(home: Path) -> list[str]:
    """Check if both Claude Code and OpenCode skill roots exist and whether they diverge."""
    claude_root = home / ".claude" / "skills" / "pizm"
    opencode_root = home / ".config" / "opencode" / "skills" / "pizm"
    if not claude_root.is_dir() or not opencode_root.is_dir():
        return []

    claude_files = {p.relative_to(claude_root): p for p in claude_root.rglob("*") if p.is_file()}
    opencode_files = {p.relative_to(opencode_root): p for p in opencode_root.rglob("*") if p.is_file()}

    divergences = []
    for rel in sorted(set(claude_files.keys()) | set(opencode_files.keys())):
        if rel not in claude_files:
            divergences.append(f"Missing in Claude root: {rel}")
        elif rel not in opencode_files:
            divergences.append(f"Missing in OpenCode root: {rel}")
        else:
            if claude_files[rel].read_bytes() != opencode_files[rel].read_bytes():
                divergences.append(f"Content differs: {rel}")

    return divergences
def install(
    host: str = "both",
    source_skill_dir: Path | None = None,
    repo_bin_dir: Path | None = None,
    home_dir: Path | None = None,
) -> int:
    if sys.version_info < (3, 10):
        print("ERROR: install-pizm requires Python 3.10 or higher", file=sys.stderr)
        return 1

    home = (home_dir or Path.home()).resolve()
    repo_root = Path(__file__).resolve().parent.parent
    src_skill = (source_skill_dir or (repo_root / "skills" / "pizm")).resolve()
    src_bin = (repo_bin_dir or (repo_root / "bin")).resolve()

    if not src_skill.is_dir():
        print(f"ERROR: source skill directory not found: {src_skill}", file=sys.stderr)
        return 1

    targets: list[Path] = []
    if host in ("claude-code", "both"):
        targets.append(home / ".claude" / "skills" / "pizm")
    if host in ("opencode", "both"):
        targets.append(home / ".config" / "opencode" / "skills" / "pizm")

    # 1. Copy skill directory to target hosts
    for dest in targets:
        try:
            dest.mkdir(parents=True, exist_ok=True)
            for root_dir, dirs, files in os.walk(src_skill):
                rel_path = Path(root_dir).relative_to(src_skill)
                target_dir = dest / rel_path
                target_dir.mkdir(parents=True, exist_ok=True)
                for file_name in files:
                    s_file = Path(root_dir) / file_name
                    d_file = target_dir / file_name
                    shutil.copy2(s_file, d_file)
            print(f"INSTALL_SKILL_OK: {dest}")
        except (OSError, PermissionError) as e:
            print(f"ERROR: failed to install skill to {dest}: {e}", file=sys.stderr)
            return 1

    # 2. Copy helpers to $HOME/.local/bin/ (self-contained, no symlinks to repo)
    local_bin = home / ".local" / "bin"
    try:
        local_bin.mkdir(parents=True, exist_ok=True)
    except (OSError, PermissionError) as e:
        print(f"ERROR: failed to create local bin directory {local_bin}: {e}", file=sys.stderr)
        return 1

    for helper in HELPERS:
        src_helper = src_bin / helper
        if not src_helper.is_file():
            print(f"ERROR: source helper executable not found: {src_helper}", file=sys.stderr)
            return 1

        dest_helper = local_bin / helper
        try:
            if dest_helper.is_symlink() or dest_helper.is_file():
                dest_helper.unlink()
            shutil.copy2(src_helper, dest_helper)
            dest_helper.chmod(dest_helper.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
            print(f"INSTALL_HELPER_OK: {dest_helper}")
        except (OSError, PermissionError) as e:
            print(f"ERROR: failed to install helper {helper} to {dest_helper}: {e}", file=sys.stderr)
            return 1

    # 3. Test installed checkpoint executable
    installed_checkpoint = local_bin / "pizm-checkpoint"
    if not installed_checkpoint.is_file():
        print(f"ERROR: installed checkpoint not found: {installed_checkpoint}", file=sys.stderr)
        return 1
    try:
        smoke = subprocess.run(
            [sys.executable, str(installed_checkpoint), "--help"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if smoke.returncode != 0:
            print(
                f"ERROR: installed checkpoint smoke test failed (exit {smoke.returncode}):\n{smoke.stderr}",
                file=sys.stderr,
            )
            return 1
        print("TEST_CHECKPOINT_OK")
    except Exception as e:
        print(f"ERROR: installed checkpoint execution failed: {e}", file=sys.stderr)
        return 1

    # 4. Enforce coherence across installed skill roots
    divergences = check_skill_roots_coherence(home)
    if divergences:
        print(
            "ERROR: Divergent skill roots detected between ~/.claude/skills/pizm and ~/.config/opencode/skills/pizm:\n"
            + "\n".join(f"  - {d}" for d in divergences)
            + "\nRun 'install-pizm --host both' to synchronize, or remove the stale installation.",
            file=sys.stderr,
        )
        return 1

    print("INSTALL_COMPLETE: Native Pizm installed successfully.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Install Native Pizm skill and helpers")
    parser.add_argument(
        "--host",
        choices=["claude-code", "opencode", "both"],
        default="both",
        help="Target host harness (default: both)",
    )
    args = parser.parse_args()
    return install(host=args.host)


if __name__ == "__main__":
    sys.exit(main())
